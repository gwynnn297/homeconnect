# =============================================================================
# Local development ONLY (./gradlew bootRun + MySQL on localhost)
# Docker Compose uses root .env — not this file.
# =============================================================================

MYSQL_HOST=localhost
MYSQL_PORT=3306
DB_NAME=homeconnect
DB_USERNAME=root
DB_PASSWORD=

# Gmail OTP — App Password from https://myaccount.google.com/apppasswords
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

JWT_SECRET=dev-only-change-in-production
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

SOCKET_SERVER_HOST=0.0.0.0
SOCKET_SERVER_PORT=9092
AI_PARSER_URL=http://localhost:8000/api/v1/chat/parse

GOONG_API_KEY=
FACEPP_API_KEY=
FACEPP_API_SECRET=
FPT_AI_API_KEY=
XGATE_API_KEY=
XGATE_WEBHOOK_SECRET=

WALLET_BANK_CODE=BIDV
WALLET_BANK_ACCOUNT=
WALLET_BANK_NAME=

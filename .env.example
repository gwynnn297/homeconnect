# =============================================================================
# HomeConnect — Docker Compose environment (copy to .env in this folder)
#   cp .env.example .env
#   nano .env
#   docker compose up -d --build
# =============================================================================

TZ=Asia/Ho_Chi_Minh
HTTP_PORT=80

# Public URL for VPS (no trailing slash). Example: http://203.0.113.10
# Optional if you leave VITE_* empty — frontend uses same-origin via nginx :80.
# Example: https://homieconnect.io.vn (no trailing slash)
PUBLIC_BASE_URL=

# Frontend build-time (leave VITE_API_URL empty for same-origin /api via nginx)
VITE_API_URL=
# Set to public site URL for Socket.IO (same host, no :9092). Example:
# VITE_SOCKET_URL=https://homieconnect.io.vn
VITE_SOCKET_URL=

# -----------------------------------------------------------------------------
# MySQL (set once; changing passwords after first run breaks existing volume)
# -----------------------------------------------------------------------------
# Host bind for MySQL Workbench via SSH tunnel (VPS: keep 127.0.0.1 — do not use 0.0.0.0).
# Windows dev: if port 3306 is already used, set MYSQL_HOST_PORT=3307
MYSQL_BIND_HOST=127.0.0.1
MYSQL_HOST_PORT=3306
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_NAME=homeconnect
# Docker Compose reads these (not DB_USERNAME/DB_PASSWORD — Windows often sets those to root)
# Do not use "root" for HC_MYSQL_USER — MySQL image reserves root for MYSQL_ROOT_PASSWORD
HC_MYSQL_USER=homeconnect
HC_MYSQL_PASSWORD=change_me_db_password

# -----------------------------------------------------------------------------
# Backend (required)
# -----------------------------------------------------------------------------
JWT_SECRET=change_me_use_openssl_rand_base64_48
SPRING_PROFILES_ACTIVE=prod
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# -----------------------------------------------------------------------------
# Gmail OTP — registration / password reset (required for register/forgot-password)
# Use Google App Password (16 chars), not your normal Gmail password.
# Do NOT use spring.mail.username/password here.
# -----------------------------------------------------------------------------
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# -----------------------------------------------------------------------------
# AI service (OpenAI — optional; /health works without key)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# -----------------------------------------------------------------------------
# Frontend — Cloudinary (KYC / check-in uploads)
# -----------------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# -----------------------------------------------------------------------------
# Frontend — Goong Maps
# -----------------------------------------------------------------------------
VITE_GOONG_JS_KEY=
VITE_GOONG_REST_API_KEY=
VITE_GOONG_MAPTILES_KEY=
VITE_GOONG_API_KEY=

# -----------------------------------------------------------------------------
# Backend — integrations (optional per feature)
# -----------------------------------------------------------------------------
GOONG_API_KEY=
FACEPP_API_KEY=
FACEPP_API_SECRET=
FACEPP_COMPARE_URL=https://api-us.faceplusplus.com/facepp/v3/compare
FACEPP_MIN_CONFIDENCE=80
FPT_AI_API_KEY=
FPT_AI_OCR_URL=https://api.fpt.ai/vision/idr/vnm

# Wallet display / VietQR
WALLET_BANK_CODE=BIDV
WALLET_BANK_ACCOUNT=
WALLET_BANK_NAME=
WALLET_COMMISSION_RATE=0.15

# Automated payout (xGate)
XGATE_API_KEY=
XGATE_API_URL=https://api.xgate.vn/v1
XGATE_WEBHOOK_SECRET=

import java.util.ArrayList;
import java.util.List;
import Models.GoodStudents;
import Models.NormalStudents;
import Models.Student;
import Exceptions.InvalidFullNameException;
import Exceptions.InvalidDOBException;
import Exceptions.InvalidPhoneNumberException;

public class Main {
    public static void main(String[] args) {
        List<Student> students = new ArrayList<>();

        System.out.println("--- 1. Testing GoodStudents ---");

            GoodStudents good = new GoodStudents(
                "Nguyen Van A", "01/01/2000", "Male", "0901234567", 
                "Hanoi University", "Excellent", 3.8, "Scholarship 2024"
            );
            students.add(good);
            good.ShowMyInFor();

        System.out.println("\n--- 2. Testing NormalStudents ---");

            NormalStudents normal = new NormalStudents(
                "Le Thi B", "15/05/2001", "Female", "0987654321", 
                "Saigon University", "Good", 85, 90
            );
            students.add(normal);
            normal.ShowMyInFor();

        System.out.println("\n--- 4. Polymorphism Demo ---");
        for (Student s : students) {
            s.ShowMyInFor();
        }
    }
}
